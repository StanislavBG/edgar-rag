entrypoint = "src/server.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[env]
PORT = "8080"
PYTHONPATH = "/home/runner/workspace"

[deployment]
build = "sh install.sh"
run = ["sh", "-c", "PYTHONPATH=.pythonlibs:/home/runner/workspace python3 -m uvicorn src.server:app --host 0.0.0.0 --port 8080 --timeout-keep-alive 120 --timeout-graceful-shutdown 30"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m uvicorn src.server:app --host 0.0.0.0 --port 8080 --timeout-keep-alive 120 --timeout-graceful-shutdown 30"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 8080
externalPort = 80

[agent]
expertMode = true
