run = "pip install -e . && python -m uvicorn src.server:app --host 0.0.0.0 --port 3000"
entrypoint = "src/server.py"
language = "python3"

[nix]
channel = "stable-24_05"

[env]
PORT = "3000"

[deployment]
build = ["sh", "-c", "pip install -e ."]
run = ["sh", "-c", "python -m uvicorn src.server:app --host 0.0.0.0 --port 3000"]
deploymentTarget = "cloudrun"
