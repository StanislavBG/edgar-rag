entrypoint = "src/server.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[env]
PORT = "8080"
PYTHONPATH = "/home/runner/workspace"

[deployment]
build = "python3 -m pip install -r requirements.txt || true"
run = ["python3", "-m", "uvicorn", "src.server:app", "--host", "0.0.0.0", "--port", "8080"]
deploymentTarget = "cloudrun"
