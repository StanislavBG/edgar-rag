entrypoint = "src/server.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[env]
PORT = "8080"
PYTHONPATH = "/home/runner/workspace"

[deployment]
build = "rm -rf .pythonlibs && python3 -m pip install --target=.pythonlibs -r requirements.txt"
run = ["sh", "-c", "PYTHONPATH=.pythonlibs:/home/runner/workspace python3 -m uvicorn src.server:app --host 0.0.0.0 --port 8080"]
deploymentTarget = "cloudrun"
