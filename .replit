run = "python -m pip install -r requirements.txt && python -m uvicorn src.server:app --host 0.0.0.0 --port 3000"
entrypoint = "src/server.py"
language = "python3"
disableInstallBeforeRun = true
disableGuessImports = true

[nix]
channel = "stable-24_05"

[env]
PORT = "3000"
PYTHONPATH = "/home/runner/workspace"

[deployment]
build = ["sh", "-c", "python -m venv .venv && .venv/bin/pip install --no-cache-dir -r requirements.txt"]
run = ["sh", "-c", ".venv/bin/python -m uvicorn src.server:app --host 0.0.0.0 --port 3000"]
deploymentTarget = "cloudrun"
